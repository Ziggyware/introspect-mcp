<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(PortableBuild)' != 'true'">net8.0-windows10.0.26100.0</TargetFramework>
    <TargetFramework Condition="'$(PortableBuild)' == 'true'">net8.0</TargetFramework>
    <UseWindowsForms Condition="'$(PortableBuild)' != 'true'">true</UseWindowsForms>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
  </ItemGroup>
</Project>
